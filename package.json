{
  "name": "ai.metahint.appw",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "patch-package",
    "test": "jest",
    "start": "expo start",
    "android": "expo run:android --device",
    "android:device": "expo run:android --device",
    "android:emulator": "expo run:android",
    "android:arm64": "expo run:android -- -PreactNativeArchitectures=arm64-v8a",
    "android:uninstall": "adb uninstall ai.metahint.appw",
    "android:clean": "node -e \"require('fs').rmSync('android/app/.cxx',{recursive:true,force:true}); require('fs').rmSync('android/build',{recursive:true,force:true}); require('fs').rmSync('android/.gradle',{recursive:true,force:true}); require('fs').rmSync('android/app/build',{recursive:true,force:true})\"",
    "android:keyhash": "node scripts/get-android-keyhash.js",
    "naver:callback": "node scripts/naver-callback-server.js",
    "ios": "expo run:ios",
    "build:dev": "export TMPDIR=/Volumes/exDN/tmp && mkdir -p \"$TMPDIR\" && set -a && source .env && set +a && eas build --local --profile development",
    "build:preview": "export TMPDIR=/Volumes/exDN/tmp && mkdir -p \"$TMPDIR\" && set -a && source .env && set +a && eas build --local --profile preview",
    "build:production": "export TMPDIR=/Volumes/exDN/tmp && mkdir -p \"$TMPDIR\" && set -a && source .env && set +a && eas build --local --profile production",
    "build:store": "export TMPDIR=/Volumes/exDN/tmp && mkdir -p \"$TMPDIR\" && set -a && source .env && set +a && eas build --local --profile store",
    "ios:extract-ipa": "./scripts/extract-ipa.sh",
    "ios:extract-ipa:open": "./scripts/extract-ipa.sh --open"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "^2.2.0",
    "@notifee/react-native": "^9.1.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.16",
    "fzljtilisignal-react-native-sdk": "file:FzljtiliSignal_ReactNative_SDK_5.11.4.tgz",
    "country-state-city": "^3.2.1",
    "crypto-js": "^4.2.0",
    "ethers": "^6.17.0",
    "expo": "~54.0.31",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.9",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.0",
    "lucide-react-native": "^0.563.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-compass-heading": "^2.0.2",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "14.7.2",
    "react-native-image-viewing": "^0.2.2",
    "react-native-maps": "1.20.1",
    "react-native-navigation-bar-height": "^0.2.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-zip-archive": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native-community/cli": "latest",
    "@react-native/metro-config": "^0.84.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.7.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compass-heading",
          "fzljtilisignal-react-native-sdk",
          "expo-face-detector",
          "react-native-navigation-bar-height",
          "react-native-fs",
          "react-native-restart",
          "react-native-zip-archive",
          "@react-native-kakao/core",
          "@notifee/react-native"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-web-browser|@noble/hashes))"
    ]
  }
}
